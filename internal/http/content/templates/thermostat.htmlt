<div class="entity-environment-thermostat">
    <div class="title-row">
        <div class="name">{{.Name}}</div>
        <div class="mode-icons">
            {{if IsOffline .Connectivity}}
                <i class="bi bi-wifi-off connectivity-icon offline"
                   title="Offline since {{FormatConnectivityTime .OfflineSince}}&#10;Last online: {{FormatConnectivityTime .OnlineSince}}"></i>
            {{else if IsOnline .Connectivity}}
                <i class="bi bi-wifi connectivity-icon online"
                   title="Online since {{FormatConnectivityTime .OnlineSince}}&#10;Last offline: {{FormatConnectivityTime .OfflineSince}}"></i>
            {{end}}
            <i class="bi bi-fire heat-icon{{if or (eq .Mode "HEAT") (eq .Mode "HEATCOOL")}} configured{{end}}{{if eq .HvacStatus "HEATING"}} active{{end}}"
               title="Heat"></i>
            <i class="bi bi-snow cool-icon{{if or (eq .Mode "COOL") (eq .Mode "HEATCOOL")}} configured{{end}}{{if eq .HvacStatus "COOLING"}} active{{end}}"
               title="Cool"></i>
            {{if eq .EcoMode "MANUAL_ECO"}}
                <i class="bi bi-recycle eco" title="Eco mode"></i>
            {{end}}
        </div>
    </div>
    {{if .SensorData.IsEmpty}}
        <div>Waiting for data</div>
    {{else}}
        <div class="sensor-data">
            <div class="temp-celsius">{{printf "%.2f" .SensorData.Temperature}} C</div>
            <div class="temp-fahrenheit">{{CelsiusToFahrenheit .SensorData.Temperature | printf "%.2f"}} F</div>
            {{if .SensorData.HasHumidity}}
                <div class="humidity">
                    <span class="label"><i class="bi bi-droplet-fill"></i></span>
                    <span class="value">{{.SensorData.Humidity}}%</span>
                </div>
            {{end}}
            {{if eq .Mode "HEATCOOL"}}
                <div class="setpoint">
                    <span class="value heat">{{printf "%.1f" .HeatSetpoint}}</span><span class="separator"> - </span><span class="value cool">{{printf "%.1f" .CoolSetpoint}}</span> C
                </div>
            {{else if eq .Mode "HEAT"}}
                <div class="setpoint">
                    <span class="value heat">{{printf "%.1f" .HeatSetpoint}} C</span>
                </div>
            {{else if eq .Mode "COOL"}}
                <div class="setpoint">
                    <span class="value cool">{{printf "%.1f" .CoolSetpoint}} C</span>
                </div>
            {{end}}
            <div class="timestamp">
                <span class="label"><i class="bi bi-stopwatch"></i></span>
                <span class="value">{{RelativeTime .SensorData.LastUpdateTime}}</span>
            </div>
        </div>
        <div class="extremes">
            <div class="temp high">
                <div class="temp-data celsius">{{printf "%.2f" .HighTemperature}} C</div>
                <div class="temp-data fahrenheit">{{CelsiusToFahrenheit .HighTemperature | printf "%.2f"}} F</div>
                <div class="timestamp">{{FormatClock .HighTemperatureTime}}</div>
            </div>
            <div class="temp low">
                <div class="temp-data celsius">{{printf "%.2f" .LowTemperature}} C</div>
                <div class="temp-data fahrenheit">{{CelsiusToFahrenheit .LowTemperature | printf "%.2f"}} F</div>
                <div class="timestamp">{{FormatClock .LowTemperatureTime}}</div>
            </div>
        </div>
    {{end}}
</div>
